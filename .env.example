# Copy this file to .env and fill in real values.
# .env is gitignored — never commit the file with real keys.
#
# Local dev:  Expo CLI loads .env automatically.
# EAS builds: set the same names as EAS secrets in the project dashboard.

# Google Maps SDK for Android — used by react-native-maps <MapView>
# Get a key: https://console.cloud.google.com → APIs & Services → Credentials
# Restrict the key:
#   Application restriction: Android apps → package com.stillfreshmobile + SHA-1 fingerprints (debug & release)
#   API restriction: Maps SDK for Android only
GOOGLE_MAPS_API_KEY=your_google_maps_android_key_here

# Stripe publishable key (pk_test_… / pk_live_…) — safe for the client; never put sk_* here.
# Dashboard: https://dashboard.stripe.com/apikeys
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Google Sign-In OAuth 2.0 Web Application client ID (public; client_secret stays on the backend).
# Console: https://console.cloud.google.com → APIs & Services → Credentials
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com

# API base URL (public, baked into the bundle at build time).
# Leave empty during local development: the app derives the Expo dev-server LAN
# IP automatically and falls back to http://localhost:8080.
# Set it explicitly for any build that should not talk to a local dev server:
#   phone on the same LAN as the Windows dev box:  http://<LAN-IP>:8080
#   dev server (dev-api.jossveze.rs):             https://dev-api.jossveze.rs
EXPO_PUBLIC_API_URL=
