{
  "expo": {
    "name": "Još Sveže",
    "slug": "stillfresh",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "stillfresh",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "androidNavigationBar": {
      "backgroundColor": "#FFFFFF",
      "barStyle": "dark-content"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF7F1"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.stillfreshmobile",
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["comgooglemaps"]
      }
    },
    "android": {
      "package": "com.stillfreshmobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#FAF7F1"
      },
      "usesCleartextTraffic": true,
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "StillFresh needs location access to find nearby food offers.",
          "locationWhenInUsePermission": "StillFresh needs location access to find nearby food offers."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#9E9E9E",
          "sounds": []
        }
      ],
      "./plugins/withNotificationIcons.js",
      [
        "expo-image-picker",
        {
          "photosPermission": "StillFresh needs photo library access to upload offer images.",
          "cameraPermission": "StillFresh needs camera access to take offer photos."
        }
      ],
      "react-native-maps",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.stillfreshmobile",
          "enableGooglePay": false
        }
      ],
      "@react-native-google-signin/google-signin"
    ]
  }
}
