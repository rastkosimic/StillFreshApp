# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS / Windows / IDE
.DS_Store
Thumbs.db
*.pem
*.swp
.idea/

# local env files — .env.example is the only env file that should be committed
.env
.env.*
!.env.example

# Firebase / Google services (contain API keys) — use *.example templates
google-services.json
GoogleService-Info.plist

# Asset edit leftovers
*.bak
*.pre-depth
*.user-source

# coverage / build reports
coverage/
*.lcov

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
